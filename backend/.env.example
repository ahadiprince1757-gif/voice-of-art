# Voice of Art — Backend Environment Variables
# Copy this file to .env and fill in real values before running.
# Never commit .env to version control.

# Server port (default: 3000)
PORT=3000

# Admin credentials — CHANGE THESE before deploying
# The server refuses to start in production if ADMIN_PASSWORD is unset.
ADMIN_EMAIL=admin@voiceofart.co.ke
ADMIN_PASSWORD=replace-with-a-strong-password

# HMAC signing secret for admin session tokens — CHANGE THIS before deploying
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production if TOKEN_SECRET is unset.
TOKEN_SECRET=replace-with-a-random-64-char-hex-string

# Optional: comma-separated list of extra allowed CORS origins beyond localhost
# ALLOWED_ORIGINS=https://voiceofart.co.ke,https://www.voiceofart.co.ke

# Set to "production" on your hosting platform to enforce required env vars
# NODE_ENV=production