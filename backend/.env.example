# Voice of Art — Backend Environment Variables
# Copy this file to .env and fill in real values before running.
# Never commit .env to version control.

# ── Server ─────────────────────────────────────────────────────────────────
PORT=3000

# ── Admin credentials (legacy HMAC login for AdminModal) ──────────────────
# The server refuses to start in production if ADMIN_PASSWORD is unset.
ADMIN_EMAIL=admin@voiceofart.co.ke
ADMIN_PASSWORD=replace-with-a-strong-password

# ── HMAC signing secret for admin session tokens ───────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production if TOKEN_SECRET is unset.
TOKEN_SECRET=replace-with-a-random-64-char-hex-string

# ── Supabase (required for all database + storage features) ────────────────
# Get these from: https://app.supabase.com → your project → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...your-service-role-key-here

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed production origins (add after deploying)
# ALLOWED_ORIGINS=https://voiceofart.vercel.app,https://voiceofart.co.ke

# ── Node environment ───────────────────────────────────────────────────────
# Set to "production" on your hosting platform to enforce required env vars
# NODE_ENV=production